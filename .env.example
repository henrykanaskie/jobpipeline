# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# For running things on the host itself (tests, export script). Containers get their own.
DATABASE_URL=postgresql://jobs:change-me@localhost:5432/jobs

# Discord channel webhooks (Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=
DISCORD_ALERT_WEBHOOK_URL=

# Your resume service (docs/resume-service.md). Leave empty to skip scoring/tailoring.
# From inside Docker, a service on the host is http://host.docker.internal:<port>
RESUME_SERVICE_URL=
RESUME_SERVICE_TOKEN=
MATCH_THRESHOLD=75
SCORE_DAILY_LIMIT=300

# Live browser: noVNC password, and the link sent in CAPTCHA alerts, e.g.
# https://<host>.<tailnet>.ts.net:6080/vnc.html?autoconnect=1&resize=scale
VNC_PASSWORD=change-me-too
LIVE_BROWSER_URL=

# Optional dead-man's switches (e.g. healthchecks.io ping URLs)
HEARTBEAT_URL_CRAWLER=
HEARTBEAT_URL_SCREENING=

CRAWL_INTERVAL=900
SCREEN_INTERVAL=60
VERCEL_TOKEN=
