# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://jobs:change-me@localhost:5432/jobs
# Discord: a channel webhook URL (Server Settings -> Integrations -> Webhooks).
DISCORD_WEBHOOK_URL=
# Seconds between runs
CRAWL_INTERVAL=900
SCREEN_INTERVAL=60
# Optional: Vercel deploy token for scripts/publish_web.sh
VERCEL_TOKEN=
